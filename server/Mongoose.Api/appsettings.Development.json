{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "CookieName": "mongoose-auth",
    "EnableMvpLogin": true,
    "EnableRiotSignOn": false,
    "EnableGoogleSignOn": true,
    "VerificationMaxAttempts": 5,
    "Riot": {
      "RedirectUri": "http://localhost:5164/api/v2/auth/riot/callback",
      "ClientBaseUrl": "http://localhost:5174",
      "DefaultRegion": "euw1"
    },
    "Google": {
      "RedirectUri": "http://localhost:5164/api/v2/auth/google/callback",
      "ClientBaseUrl": "http://localhost:5174"
    }
  }
}

