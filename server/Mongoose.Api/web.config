<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore"
           path="*"
           verb="*"
           modules="AspNetCoreModule"
           resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath=".\Mongoose.Api.exe"
            arguments=""
            stdoutLogEnabled="true"
            stdoutLogFile=".\logs\stdout"
            hostingModel="OutOfProcess">
      <environmentVariables>
        <!-- ASP.NET Core Environment -->
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

        <!-- Database Configuration -->
        <!-- Note: ASP.NET Core converts double underscores (__) to colons (:) in configuration keys -->
        <!-- ConnectionStrings__Database_production maps to ConnectionStrings:Database_production -->
        <environmentVariable name="ConnectionStrings__Database_production" value="PLACEHOLDER_DB_CONNECTION" />

        <!-- Riot API Configuration -->
        <environmentVariable name="Riot__ApiKey" value="PLACEHOLDER_RIOT_API_KEY" />

        <!-- Authentication Configuration -->
        <environmentVariable name="Auth__CookieName" value="pulse-auth" />
        <environmentVariable name="Auth__SessionTimeout" value="43200" />
        <environmentVariable name="Auth__EnableMvpLogin" value="true" />

        <!-- Data Protection: persistent key ring so auth cookies survive server reboots.
             Set this to a stable folder OUTSIDE the deploy directory so keys also survive
             redeployments. The IIS app pool identity needs read/write access to this folder.
             Example: D:\Mongoose\keys -->
        <environmentVariable name="DataProtection__KeyRingPath" value="PLACEHOLDER_DATA_PROTECTION_KEY_PATH" />

        <!-- Background Jobs Configuration -->
        <environmentVariable name="Jobs__EnableMatchHistorySync" value="true" />
        <environmentVariable name="Jobs__EnableMatchCleanup" value="true" />
        <environmentVariable name="Jobs__MatchCleanupSchedule" value="02:00" />
        <environmentVariable name="Jobs__MatchRetentionDays" value="180" />
        <environmentVariable name="Jobs__MatchCleanupBatchSize" value="1000" />

        <!-- Security Configuration -->
        <environmentVariable name="Security__EncryptionSecret" value="PLACEHOLDER_ENCRYPTION_SECRET" />

        <!-- Email Configuration -->
        <environmentVariable name="Email__DevMode" value="false" />
        <environmentVariable name="Email__SmtpHost" value="PLACEHOLDER_SMTP_HOST" />
        <environmentVariable name="Email__SmtpPort" value="587" />
        <environmentVariable name="Email__SmtpUsername" value="PLACEHOLDER_SMTP_USERNAME" />
        <environmentVariable name="Email__SmtpPassword" value="PLACEHOLDER_SMTP_PASSWORD" />
        <environmentVariable name="Email__FromEmail" value="PLACEHOLDER_SMTP_FROM_EMAIL" />
        <environmentVariable name="Email__FromName" value="Mongoose.gg" />

        <!-- Logging Configuration (optional - can be overridden) -->
        <environmentVariable name="Logging__LogLevel__Default" value="Warning" />
        <environmentVariable name="Logging__LogLevel__Microsoft.AspNetCore" value="Warning" />
      </environmentVariables>
    </aspNetCore>

    <!-- Ensure CORS headers from ASP.NET Core are passed through -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>